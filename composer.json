{
  "name": "markingman/database",
  "description": "Simple PHP database wrapper.",
  "license": "MIT",
  "type": "library",
  "require": {
    "php": ">=8.3",
    "ext-mysqli": "*"
  },
  "autoload": {
    "psr-4": {
      "MarkIngman\\Database\\": [
        "src/"
      ]
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MarkIngman\\Database\\": [
        "tests/"
      ]
    }
  },
  "require-dev": {
    "phpunit/phpunit": "~12.1.2",
    "phpstan/phpstan": "~2.1.12"
  },
  "config": {
    "vendor-dir": "vendor"
  }
}
